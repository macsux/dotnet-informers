<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- writes deploy/rbac/role.yaml from the controller registrations on build (the AppSet CRD is generated by samples/Controllers) -->
    <InformersGenerateManifests>true</InformersGenerateManifests>
    <InformersCrdsTool>$(MSBuildThisFileDirectory)../../src/Crds/bin/$(Configuration)/net10.0/Steeltoe.Informers.Crds.dll</InformersCrdsTool>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Controllers\Steeltoe.Informers.Samples.Controllers.csproj" />
    <ProjectReference Include="..\..\src\Crds\Steeltoe.Informers.Crds.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="..\..\src\Crds\build\Steeltoe.Informers.Crds.targets" />
</Project>
