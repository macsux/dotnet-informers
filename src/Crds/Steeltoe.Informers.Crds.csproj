<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <Description>Build-time generator of CustomResourceDefinitions from C# entity types (KubeOps' Transpiler over a MetadataLoadContext; no user code runs).</Description>
    <!-- R0.6: a build-time tool in its own process, exempt from trimming -->
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="KubeOps.Transpiler" />
  </ItemGroup>
  <PropertyGroup>
    <!-- packaged as build targets plus the generator under tools/, referenced as a development dependency -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackGenerator</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build" />
  </ItemGroup>
  <Target Name="PackGenerator">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)**\*" Exclude="$(OutputPath)**\*.pdb" PackagePath="tools/$(TargetFramework)/any/%(RecursiveDir)" />
    </ItemGroup>
  </Target>
</Project>
